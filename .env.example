# PostgreSQL
DATABASE_URL="postgresql://amigo:amigo@localhost:5432/amigo"
# Banco usado pelos testes de integração (é limpo a cada execução)
TEST_DATABASE_URL="postgresql://amigo:amigo@localhost:5432/amigo_test"

# Segredo do servidor: deriva as chaves de cifragem dos pares e dos HMACs.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NUNCA troque em produção sem migração: os sorteios existentes ficariam ilegíveis.
APP_SECRET=""

# URL pública (links do WhatsApp, sitemap, Open Graph).
# ATENÇÃO: precisa estar definida também no BUILD (páginas de SEO, sitemap e
# robots são geradas no build com este valor).
APP_URL="http://localhost:3000"

# "true" apenas atrás de proxy confiável que define X-Forwarded-For (Vercel, Nginx...)
TRUST_PROXY="false"

# Banco dos testes E2E (Playwright) — recriado a cada execução
E2E_DATABASE_URL="postgresql://amigo:amigo@localhost:5432/amigo_e2e"

# Anúncios (Google AdSense) — opcionais. Sem eles, nenhum anúncio aparece.
# Defina também no BUILD (a página inicial é estática).
ADSENSE_CLIENT_ID=""
ADSENSE_SLOT_ID=""

# E-mail de contato exibido na Política de Privacidade (recomendado; LGPD). Defina também no build.
CONTACT_EMAIL=""

# Conexões com o banco por processo (padrão 20). Total = APP_WORKERS × este valor < max_connections do Postgres (100).
DATABASE_POOL_MAX="20"

# Conexão DIRETA (sem pooler) para migrações — ex.: Neon. Opcional; sem ela, usa DATABASE_URL.
DIRECT_DATABASE_URL=""
