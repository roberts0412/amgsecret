# Configuração do servidor (Docker Compose). Copie para .env e preencha.

# Seu domínio, sem https:// (o DNS precisa apontar para este servidor)
DOMAIN=amigosecreto.seudominio.com.br
# O mesmo domínio, com https://
APP_URL=https://amigosecreto.seudominio.com.br

# Gere cada um com:  openssl rand -hex 32
# (hex para não quebrar a URL do banco)
POSTGRES_PASSWORD=
# Gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# GUARDE UMA CÓPIA: sem ele, os sorteios existentes ficam ilegíveis.
APP_SECRET=

# Opcionais
CONTACT_EMAIL=
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
# Tag do Programa de Associados da Amazon (ex.: meusite-20)
AMAZON_ASSOCIATE_TAG=
# Senha do painel de números em /painel (16+ caracteres; vazio = painel desligado)
OWNER_PANEL_PASSWORD=
# E-mails de aviso (Resend) — opcionais. Veja docs/DEPLOY-NETLIFY.md (seção E-mails)
RESEND_API_KEY=
EMAIL_FROM=
# Lembretes diários: gere com openssl rand -hex 32 e agende no crontab (docs/DEPLOY.md)
CRON_SECRET=

# Processos do site (padrão: 1 por núcleo de CPU, até 8)
APP_WORKERS=
